# --- Pflicht -----------------------------------------------------------------
# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon public" Key oder "publishable" Key (sb_publishable_...) – NIE den service_role/secret Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- KI (empfohlen) ------------------------------------------------------------
# platform.openai.com → API keys. Liest PDFs, ordnet Links ein, Websuche als Rückfall.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modell für die Websuche über OpenAI (nur wenn kein TAVILY_API_KEY gesetzt ist)
OPENAI_SEARCH_MODEL=gpt-4.1-mini

# --- Websuche (optional, besser und günstiger) --------------------------------
# tavily.com → 1.000 Suchen pro Monat gratis
TAVILY_API_KEY=

# --- Gmail ----------------------------------------------------------------------
# Google Cloud Console → APIs & Dienste → Anmeldedaten → OAuth-Client-ID (Webanwendung)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Beliebige lange Zufallszeichenkette (mind. 32 Zeichen). Verschlüsselt die Gmail-Zugänge.
# Erzeugen z. B. mit: openssl rand -base64 32
# Nicht mehr ändern, sonst müssen Postfächer neu verbunden werden.
TOKEN_ENCRYPTION_KEY=
# Wie weit zurück beim ersten Abruf (Tage)
GMAIL_BACKFILL_DAYS=365
